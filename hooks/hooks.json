{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/kb-trigger.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|.*Comment|.*Review|.*Revision|.*Issue|.*Ticket|.*PullRequest",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/kb-prose-judge.js",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
