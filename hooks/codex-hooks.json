{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/kb-prose-judge-codex.js\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/run-node.sh\" \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/kb-trigger.js\""
          }
        ]
      }
    ]
  }
}
